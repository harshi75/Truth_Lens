# TruthLens — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=3000

# Optional: your Gemini API key (from https://aistudio.google.com/apikey).
# When set, TruthLens uses Gemini for three things:
#   1. Live evidence search (Gemini + Google Search grounding),
#      replacing the offline demo dataset in lib/demoData.js.
#   2. Claim classification (FACTUAL/OPINION/PREDICTION/SUBJECTIVE),
#      as a check on top of the rule-based classifier.
#   3. Writing the plain-language verdict explanation — it can never
#      change the verdict itself, which is always computed
#      deterministically by lib/verdictEngine.js.
# Not required to run TruthLens — without it, every one of the above
# falls back to the fully offline, deterministic pipeline and every
# result is clearly labeled "Demo Evidence".
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash).
GEMINI_MODEL=
